[
  {
    "name": "acknowledge_review",
    "description": "在 Agent 实际读到固定反馈后标记领取。不要在 wait_review 返回之前领取；只接受当前轮最新反馈。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "session_id",
        "submission_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "attach_review_baseline",
    "description": "为缺少固定基线的原评审补入修改前流程图，先核验修改前源码，沿用 session ID 与评审轮次。已存在的基线保持固定。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseline_file": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id",
        "baseline_file",
        "source_root"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "cleanup_review",
    "description": "Agent 实际取得最终通过结果后归档评审（默认、可恢复）。永久删除或清理未完成评审须有明确用户授权。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": [
            "archive",
            "delete"
          ]
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "session_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_review",
    "description": "读取完整评审、固定提交和历史快照；可读取已归档任务。等待人工意见请使用 wait_review。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "session_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_reviews",
    "description": "按 Agent 上下文和活动或归档状态查找已有评审；连接恢复后先定位原会话，避免重复创建。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "all"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "reply_review",
    "description": "向原批注添加临时 Agent 回复；回复不会替人确认解决。最终回应可与 revise_review 一起发布。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "comment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "session_id",
        "comment_id",
        "body"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "restore_review",
    "description": "从归档恢复同一评审，保留原会话 ID、批注和历史。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "session_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "revise_review",
    "description": "核验当前工作区源码，按 Agent 实际处理的 base_round 发布新版流程与最终回复。逻辑未变时必须填写 unchanged_reason。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "review_file": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "base_round": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "unchanged_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "replies_file": {
          "type": "string",
          "minLength": 1
        },
        "public_url": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "review_file",
        "source_root",
        "base_round",
        "summary"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "start_review",
    "description": "核验本机源码并创建独立评审，立即返回会话 ID 与网页地址。随后用 wait_review 等待人工提交；不要反复调用 get_review 检查。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "review_file": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "baseline_file": {
          "type": "string",
          "minLength": 1
        },
        "baseline_source_root": {
          "type": "string",
          "minLength": 1
        },
        "baseline_review": {
          "type": "boolean"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "public_url": {
          "type": "string"
        },
        "cleanup_on_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "review_file",
        "source_root",
        "purpose"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "verify_review",
    "description": "只读核验评审文件与本机源码的文件、片段摘要和快照指纹。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "review_file": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "baseline_file": {
          "type": "string",
          "minLength": 1
        },
        "baseline_source_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "review_file",
        "source_root"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "wait_review",
    "description": "在工具内部持续等待“提交本轮”或“确认通过”，保存单条批注不会返回。after_submission 使用最后实际处理的提交 ID。返回后另用 acknowledge_review 领取反馈；通过后按清理策略调用 cleanup_review。取消或断线不会领取或归档。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "after_submission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "session_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
