  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/go-dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:go": "node scripts/build-go.mjs",
    "test:go": "go test ./... -count=1",
    "package:go": "node scripts/package-go-agent.mjs",
    "test:go:agent": "node --test scripts/go-agent.test.mjs",
    "test:go:compat": "node --test scripts/go-compat.test.mjs",
    "package:dsh": "node scripts/package-dsh.mjs",
    "test:dsh": "node --test scripts/dsh-plugin.test.mjs",
    "test:dsh:integration": "node scripts/dsh-integration.mjs",
    "test:go:e2e": "node scripts/go-e2e.mjs",
    "test": "npm run test:go && npm run test:frontend",
    "review": "node scripts/go-cli.mjs",
    "package:agent": "node scripts/package-go-agent.mjs",
    "test:agent": "node --test scripts/go-agent.test.mjs",
    "release:agent": "node scripts/release-agent.mjs",
    "test:release": "node --test scripts/release-agent.test.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/go-dev.mjs --preview",
    "test:frontend": "node --test src/*.test.ts",
    "test:dev": "node --test scripts/go-dev.test.mjs",
    "test:codex": "node --test scripts/go-codex.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
