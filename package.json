{
  "name": "logic-margin",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts server/*.test.ts bin/*.test.ts",
    "review": "node bin/entry.ts",
